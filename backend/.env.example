# LLM / Embeddings
GOOGLE_API_KEY=

# Code execution sandbox
E2B_API_KEY=

# Auth
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Storage (defaults are usually fine — resolved to absolute paths in config.py)
APP_DB_PATH=storage/sqlite/app.db
CHECKPOINT_DB_PATH=storage/sqlite/checkpoints.db
EMPLOYEES_DB_PATH=storage/sqlite/employees_db-full-1.0.6.db
CHROMA_DIR=storage/chroma_financial_db
RAG_DATA_DIR=data/rag_data
DEBUG_MODE=false

# Azure Blob Storage — code-execution datasets (auth: az login locally / managed identity in Azure)
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER=code-execution
AZURE_STORAGE_CODE_DATA_PREFIX=code_data/
CODE_DATA_MAX_UPLOAD_MB=50

# Foundry web search agent (auth: az login locally / managed identity in Azure).
# Leave FOUNDRY_PROJECT_ENDPOINT blank to use DuckDuckGo only.
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_WEB_SEARCH_AGENT_NAME=adaptiverag-websearch
FOUNDRY_REQUEST_TIMEOUT_SECONDS=45
WEB_SEARCH_FALLBACK_ENABLED=true